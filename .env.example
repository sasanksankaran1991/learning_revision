# Copy to .env and fill in. Never commit .env.
# Generate values with: python -m app.cli gen-secrets

JWT_SECRET=replace-with-generated-secret
FERNET_KEYS=replace-with-generated-fernet-key
CORS_ORIGINS=https://learn.sasanksankaran.in,http://localhost:5173
PUBLIC_BASE_URL=https://learn.sasanksankaran.in
USD_INR_RATE=84
# false on the Mac while you use http://localhost:5173
# true on the Windows PC, where the public site is HTTPS
COOKIE_SECURE=false

# Creates this admin on startup only if the username does not exist yet.
# At least 10 characters. A password changed in the app is not reset on restart.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-10-characters
